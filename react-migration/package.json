{
  "name": "tootsville-react-client",
  "version": "1.0.0",
  "description": "Tootsville V React + Three.js client with preserved communications protocol",
  "main": "src/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:static": "node scripts/build-static.js",
    "build:mobile": "node scripts/build-mobile.js",
    "build:android": "node scripts/build-mobile.js android",
    "build:ios": "node scripts/build-mobile.js ios",
    "build:firetv": "node scripts/build-mobile.js firetv",
    "build:tv": "npm run build:firetv && npm run build:samsungtv && npm run build:lgwebos && npm run build:roku",
    "build:samsungtv": "node scripts/build-mobile.js samsungtv",
    "build:lgwebos": "node scripts/build-mobile.js lgwebos",
    "build:roku": "node scripts/build-mobile.js roku",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --testPathPattern=unit",
    "test:integration": "react-scripts test --testPathPattern=integration",
    "test:mobile": "react-scripts test --testPathPattern=mobile",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:e2e": "npm run build && npx cypress run",
    "eject": "react-scripts eject",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write src/**/*.{js,jsx,css,json}",
    "type-check": "tsc --noEmit",
    "build:prod": "GENERATE_SOURCEMAP=false react-scripts build",
    "analyze": "npm run build:prod && npx webpack-bundle-analyzer build/static/js/*.js",
    "doc:texinfo": "node scripts/generate-docs.js texinfo",
    "doc:html": "node scripts/generate-docs.js html",
    "doc:pdf": "node scripts/generate-docs.js pdf",
    "doc:mobile": "node scripts/generate-docs.js mobile",
    "doc:all": "npm run doc:texinfo && npm run doc:html && npm run doc:pdf && npm run doc:mobile",
    "deploy": "npm run build:prod && node scripts/deploy.js",
    "deploy:mobile": "npm run build:mobile && node scripts/deploy-mobile.js",
    "optimize": "node scripts/optimize.js",
    "optimize:mobile": "node scripts/optimize-mobile.js",
    "security": "npm audit",
    "security:fix": "npm audit fix",
    "security:mobile": "node scripts/security-audit.js mobile",
    "dev": "react-scripts start",
    "dev:mobile": "BROWSER=none react-scripts start",
    "check": "npm run lint && npm run test && npm run build",
    "check:mobile": "npm run lint && npm run test:mobile && npm run build:mobile",
    "package": "npm run build && node scripts/package.js",
    "package:mobile": "npm run build:mobile && node scripts/package-mobile.js",
    "clean": "rm -rf build dist coverage .nyc_output",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json",
    "update": "npm update",
    "update:check": "npm outdated",
    "version": "node scripts/version.js",
    "platforms": "node scripts/platforms.js",
    "requirements": "node scripts/requirements.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.3",
    "@react-three/fiber": "^9.3.0",
    "@tanstack/react-query": "^5.59.0",
    "archiver": "^7.0.1",
    "classnames": "^2.3.0",
    "firebase": "^12.1.0",
    "firebaseui": "^6.0.0",
    "jsdoc": "^4.0.0",
    "jsdoc-to-markdown": "^9.1.2",
    "lodash": "^4.17.21",
    "node-forge": "^1.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-scripts": "^5.0.1",
    "sharp": "^0.34.3",
    "socket.io-client": "^4.7.0",
    "three": "^0.179.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/lodash": "^4.14.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "autoprefixer": "^10.4.0",
    "cssnano": "^7.1.0",
    "cypress": "^15.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.0.5",
    "postcss": "^8.4.0",
    "prettier": "^3.6.2",
    "puppeteer": "^24.17.0",
    "rollup": "^4.47.1",
    "selenium-webdriver": "^4.0.0",
    "terser": "^5.0.0",
    "typescript": "^5.0.0",
    "webpack-bundle-analyzer": "^4.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": ".",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  }
}
