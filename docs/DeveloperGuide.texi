@node GameStore, , Stores, Stores
@section GameStore

@deftypefn {Store} {Object} useGameStore ()

Zustand store for global game state management.

@strong{State Properties:}

@table @asis
@item @code{user} (Object)
Current user information
@item @code{character} (Object)
Player character data
@item @code{world} (Object)
3D world state
@item @code{characters} (Array)
Other players in the world
@item @code{items} (Array)
World items
@item @code{weather} (Object)
Weather conditions
@item @code{connection} (Object)
Connection status
@item @code{ui} (Object)
User interface state
@end table

@strong{Actions:}

@deftypefn {Action} {void} setUser (@var{user})

Set the current user.

@var{user} is the user object
@end deftypefn

@deftypefn {Action} {void} setCharacter (@var{character})

Set the player character.

@var{character} is the character object
@end deftypefn

@deftypefn {Action} {void} updateWorld (@var{world})

Update the world state.

@var{world} is the world object
@end deftypefn

@strong{Example:}
@example
import { useGameStore } from './stores/GameStore';

function MyComponent() {
  const { user, character, setUser } = useGameStore();
  
  const handleLogin = (userData) => {
    setUser(userData);
  };
  
  return (
    <div>
      <p>Welcome, @{user.name}!</p>
      <p>Character: @{character.name}</p>
    </div>
  );
}
@end example
@end deftypefn

