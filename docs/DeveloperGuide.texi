@node CommunicationService, MobilePlatformService, Services, Services
@section CommunicationService

@deftypefn {Class} {CommunicationService} CommunicationService ()

WebSocket communication service for connecting to the Tootsville server.

@strong{Methods:}

@deftypefn {Method} {Promise<boolean>} connect (@var{cluster})

Connect to the Tootsville server.

@var{cluster} is the server cluster name (e.g., 'test.tootsville.org')

@strong{Returns:} Promise that resolves to connection success status
@end deftypefn

@deftypefn {Method} {void} disconnect ()

Disconnect from the server.
@end deftypefn

@deftypefn {Method} {boolean} isConnected ()

Check if currently connected to the server.

@strong{Returns:} True if connected, false otherwise
@end deftypefn

@deftypefn {Method} {void} send (@var{message})

Send a message to the server.

@var{message} is the message object to send
@end deftypefn

@deftypefn {Method} {Function} onMessage (@var{handler})

Register a message handler.

@var{handler} is the function to handle incoming messages

@strong{Returns:} Function to remove the handler
@end deftypefn

@strong{Example:}
@example
const commService = new CommunicationService();
await commService.connect('test.tootsville.org');

commService.onMessage((message) => {
  console.log('Received:', message);
});

commService.send({
  type: 'move',
  data: { x: 100, y: 50, z: 200 }
});
@end example
@end deftypefn

@node MobilePlatformService, , CommunicationService, Services
@section MobilePlatformService

@deftypefn {Class} {MobilePlatformService} MobilePlatformService ()

Mobile platform detection and optimization service.

@strong{Methods:}

@deftypefn {Method} {Object} detectPlatform ()

Detect the current platform.

@strong{Returns:} Platform information object
@end deftypefn

@deftypefn {Method} {Object} detectCapabilities ()

Detect device capabilities.

@strong{Returns:} Capabilities object
@end deftypefn

@deftypefn {Method} {Object} getOptimizations ()

Get platform-specific optimizations.

@strong{Returns:} Optimization settings object
@end deftypefn

@strong{Example:}
@example
const platformService = new MobilePlatformService();
const platform = platformService.detectPlatform();
const optimizations = platformService.getOptimizations();

console.log('Platform:', platform.type);
console.log('Optimizations:', optimizations);
@end example
@end deftypefn

