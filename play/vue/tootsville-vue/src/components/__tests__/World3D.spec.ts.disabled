    name: 'Sky',
    template: '<div class="sky-mock"></div>'
  },
  useFrame: vi.fn(),
  // Add missing Three.js components that are used in the template
  ambientLight: {
    name: 'ambientLight',
    template: '<div class="ambient-light-mock"></div>'
  },
  directionalLight: {
    name: 'directionalLight',
    template: '<div class="directional-light-mock"></div>'
  },
